# ─────────────────────────────────────────────────────────
# Env vars cho Day09 Multi-Agent Shopping Assistant
# Copy thành .env (local dev) hoặc set trực tiếp trên Railway Dashboard
# ❌ KHÔNG commit .env lên Git
# ─────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────
APP_NAME=Shopping Assistant Multi-Agent
APP_VERSION=1.0.0
ENVIRONMENT=production
PORT=8000

# ── Security — BẮT BUỘC thay trong production ────────────
AGENT_API_KEY=dev-key-change-me-in-production

# ── LLM Provider (chọn 1) ────────────────────────────────
# Option A: Google Gemini
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your-google-api-key
# LLM_MODEL=gemini-2.0-flash

# Option B: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# LLM_MODEL=gpt-4o-mini

# Option C: OpenRouter
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-api-key
# LLM_MODEL=deepseek/deepseek-chat

# Option D: Custom LLM endpoint (default — hiện tại đang dùng)
LLM_PROVIDER=custom
CUSTOM_LLM_BASE_URL=https://opencode.ai/zen/go/v1
CUSTOM_LLM_API_KEY=your-custom-api-key
CUSTOM_LLM_MODEL=deepseek-v4-flash

# ── LLM Settings ─────────────────────────────────────────
LLM_TEMPERATURE=0

# ── RAG / Embeddings ─────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4

# ── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=*
