# ─────────────────────────────────────────────────────────
# Env vars cho VinUni AI Handbook Chatbot
# Copy thành .env (local dev) hoặc set trực tiếp trên Railway Dashboard
# ❌ KHÔNG commit .env lên Git
# ─────────────────────────────────────────────────────────

# ── Gemini API ───────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here

# ── Discord ──────────────────────────────────────────────
DISCORD_INVITE_URL=https://discord.gg/your-invite-code

# ── Models ───────────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash

# ── Rulebase (tuỳ chọn, để trống nếu không dùng) ────────
# Trên Railway: để trống hoặc đặt path tới rulebase.json nếu có
RULEBASE_PATH=./data/rulebase.json

# ── Server ───────────────────────────────────────────────
PORT=8080
